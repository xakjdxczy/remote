<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1022">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="作为摄像头"
            android:textColor="#EAF0FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="把本机相机和麦克风送给旁边的电脑。Wi‑Fi 局域网或 USB 二选一，不要和远程被控同时开。"
            android:textColor="#9AA6C4"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/cam_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/cam_wifi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Wi‑Fi 局域网"
                android:textColor="#EAF0FF" />

            <RadioButton
                android:id="@+id/cam_usb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:text="USB"
                android:textColor="#EAF0FF" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="电脑地址（Wi‑Fi 填局域网 IP；USB+adb reverse 填 127.0.0.1）"
            android:textColor="#9AA6C4"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/cam_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#141B34"
            android:hint="192.168.1.8 或 127.0.0.1"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#EAF0FF"
            android:textColorHint="#63708F" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="配对码（电脑 RemoteDesk 页「手机摄像头」上的 6 位数字）"
            android:textColor="#9AA6C4"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/cam_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#141B34"
            android:hint="123456"
            android:inputType="number"
            android:maxLength="6"
            android:padding="12dp"
            android:textColor="#FFD15C"
            android:textColorHint="#63708F" />

        <Button
            android:id="@+id/cam_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#5B8CFF"
            android:text="开始作为摄像头"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/cam_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2A3352"
            android:text="切换前后摄像头"
            android:textColor="#EAF0FF" />

        <Button
            android:id="@+id/cam_mute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2A3352"
            android:text="静音 / 开麦"
            android:textColor="#EAF0FF" />

        <Button
            android:id="@+id/cam_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#8B3A4A"
            android:text="停止"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/cam_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="未连接"
            android:textColor="#22E6C8"
            android:textSize="16sp" />
    </LinearLayout>
</ScrollView>
