<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1022">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="尘埃X · 远程被控"
            android:textColor="#EAF0FF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="让这台安卓设备可被远程协助（画面走 P2P 直连）"
            android:textColor="#9AA6C4"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="信令服务器"
            android:textColor="#9AA6C4"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/server_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#141B34"
            android:padding="12dp"
            android:text="wss://117.72.108.246/ws"
            android:textColor="#EAF0FF"
            android:textColorHint="#63708F"
            android:inputType="textUri" />

        <Button
            android:id="@+id/btn_start"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#5B8CFF"
            android:text="开始被控（授权录屏）"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btn_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2A3352"
            android:text="停止"
            android:textColor="#EAF0FF" />

        <Button
            android:id="@+id/btn_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#2A3352"
            android:text="开启无障碍（允许远程点击/滑动）"
            android:textColor="#EAF0FF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#141B34"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态"
                android:textColor="#9AA6C4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="未连接"
                android:textColor="#22E6C8"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="识别码"
                android:textColor="#9AA6C4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/device_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— — —"
                android:textColor="#EAF0FF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="临时密码"
                android:textColor="#9AA6C4"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="——————"
                android:textColor="#FFD15C"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#22314F" />

            <TextView android:id="@+id/stat_method"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="连接方式：--"
                android:textColor="#22E6C8" android:textSize="14sp" />
            <TextView android:id="@+id/stat_speed"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="实时网速：--"
                android:textColor="#EAF0FF" android:textSize="14sp" />
            <TextView android:id="@+id/stat_session"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="本次流量：0 B"
                android:textColor="#EAF0FF" android:textSize="14sp" />
            <TextView android:id="@+id/stat_total"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="历史流量：0 B"
                android:textColor="#EAF0FF" android:textSize="14sp" />
            <TextView android:id="@+id/stat_latency"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="延迟：-- ms"
                android:textColor="#FFD15C" android:textSize="14sp" />
            <TextView android:id="@+id/stat_access"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="远程操作(无障碍)：未开启"
                android:textColor="#FF6B8B" android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="在电脑/手机浏览器打开控制端网页，输入以上识别码与密码即可远程控制本机。画面走 WebRTC 视频编码(H.264/VP8)，30fps，540p 低延迟。"
                android:textColor="#63708F"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
