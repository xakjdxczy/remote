<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/DustX.CardLabel"
            android:text="连接方式" />

        <RadioGroup
            android:id="@+id/cam_transport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/cam_wifi"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="Wi‑Fi"
                android:textColor="@color/chip_text"
                android:textStyle="bold" />

            <RadioButton
                android:id="@+id/cam_usb"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip"
                android:button="@null"
                android:gravity="center"
                android:text="USB"
                android:textColor="@color/chip_text"
                android:textStyle="bold" />
        </RadioGroup>

        <TextView
            android:id="@+id/cam_mode_hint"
            style="@style/DustX.Hint"
            android:layout_marginTop="10dp"
            android:text="填电脑局域网 IP 和配对码。USB 网络共享也走这里，填电脑在那条 USB 网上的 IP。" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cam_pair_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/DustX.CardLabel"
            android:text="配对" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="电脑地址"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/cam_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="192.168.1.8"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="@color/text"
            android:textColorHint="@color/hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="配对码"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/cam_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_input"
            android:hint="电脑上的 6 位数字"
            android:inputType="number"
            android:letterSpacing="0.18"
            android:maxLength="6"
            android:padding="12dp"
            android:textColor="@color/gold"
            android:textColorHint="@color/hint"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/cam_start"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/mint"
        android:text="开始作为摄像头"
        android:textColor="@color/ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/cam_switch"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/ghost"
            android:text="切换镜头"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/cam_mute"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/ghost"
            android:text="静音"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/cam_stop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:backgroundTint="@color/danger"
            android:text="停止"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/DustX.CardLabel"
            android:text="状态" />

        <TextView
            android:id="@+id/cam_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="未连接"
            android:textColor="@color/mint"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
