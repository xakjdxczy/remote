#include <winver.h>

#define DUSTX_VER_COMMA @DUSTX_APP_VERSION_COMMA@
#define DUSTX_VER_STR "@DUSTX_APP_VERSION@"

1 VERSIONINFO
 FILEVERSION DUSTX_VER_COMMA
 PRODUCTVERSION DUSTX_VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "DustX"
            VALUE "FileDescription", "DustX"
            VALUE "FileVersion", DUSTX_VER_STR
            VALUE "InternalName", "DustX"
            VALUE "OriginalFilename", "DustX.exe"
            VALUE "ProductName", "DustX"
            VALUE "ProductVersion", DUSTX_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
