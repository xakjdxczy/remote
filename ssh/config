# 本机实际使用的定义在 ~/.ssh/config。此文件只作仓库备份，不要放入私钥。
Host dustx-windows
  HostName 127.0.0.1
  Port 2222
  User my_simple_user
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ServerAliveInterval 15
  ServerAliveCountMax 12
  TCPKeepAlive yes

Host dustx-vps
  HostName 117.72.108.246
  User root
  IdentityFile ~/.ssh/id_ed25519_dustx_vps
  IdentitiesOnly yes
  ServerAliveInterval 15
  ServerAliveCountMax 12
